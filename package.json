{
  "name": "hisabkitab",
  "version": "0.0.1",
  "private": true,
  "description": "AI-first group expense splitter for the Indian market",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "mobile": "turbo run dev --filter=mobile",
    "web": "turbo run dev --filter=web"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "next": "14.2.15",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "ajv": "^8.17.0",
    "react-native-reanimated": "~3.16.1"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "expo-build-properties": "^55.0.10"
  }
}
